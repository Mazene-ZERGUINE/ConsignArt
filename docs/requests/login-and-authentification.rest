### 5. Login as a COLLECTOR account (200 OK)
POST http://localhost:3000/api/v1/auth/login
Content-Type: application/json

{
  "email": "collector@test.com",
  "password": "Password1234!",
  "userRole": "collector"
}

> {%
  client.test("Collector login succeeds", function () {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
  client.global.set("collectorAccessToken", response.body.data.token.accessToken);
%}

### Get COLLECTOR information (200 OK)
GET http://localhost:3000/api/v1/auth/me
Authorization: Bearer {{collectorAccessToken}}

> {%
  client.test("Authenticated collector profile is returned", function () {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
%}


